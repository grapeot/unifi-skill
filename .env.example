# Copy to .env and fill in your own controller details.
# This file is for local use only; .env is gitignored. Never commit a real
# cookie, a real LAN address, or a real SSID name to a public repository.

# UniFi Network Controller base URL (UniFi OS Server behind /proxy/network).
# FAKE example — replace with your controller's LAN address and port:
UNIFI_BASE_URL=https://192.0.2.10:11443

# File holding the browser session cookie header value ("TOKEN=...; JSESSIONID=...").
# The loader resolves a leading ~. Default if unset: ~/.config/unifi-skill/cookie.txt
# chmod 600 this file. Refresh procedure: docs/cookie_refresh.md
UNIFI_COOKIE_FILE=~/.config/unifi-skill/cookie.txt

# Directory for `export` snapshots (auto-created). Default: ./tmp/unifi-backups/
# UNIFI_EXPORT_DIR=/absolute/path/to/unifi-backups

# Site name in the controller path. Default: default
# UNIFI_SITE=default
